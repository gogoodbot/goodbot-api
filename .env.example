# IMPORTANT: Copy this file to .env and fill in your actual credentials
# DO NOT commit .env to version control
# ROTATE ALL CREDENTIALS if they were previously exposed

# JWT Configuration
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MILLISECONDS=86400000

# Supabase Database Configuration
DATABASE_URL=https://your-project-id.supabase.co
DATABASE_API_KEY=your-supabase-anon-key-here

# Google AI Configuration
GOOGLE_API_KEY=your-google-ai-api-key-here

# CORS Configuration (comma-separated list)
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:8080,https://your-production-domain.com
